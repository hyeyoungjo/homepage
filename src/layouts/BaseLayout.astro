---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Hye-Young Jo', description = '' } = Astro.props;
const pageTitle = title === 'Hye-Young Jo' ? title : `${title} — Hye-Young Jo`;

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Contact', href: `mailto:${SITE.email}` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">Hye-Young Jo</a>
        <nav class="site-nav">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} Hye-Young Jo</div>
    </footer>
  </body>
</html>
