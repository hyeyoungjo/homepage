---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Hye-Young Jo', description = '' } = Astro.props;
const pageTitle = title === 'Hye-Young Jo' ? title : `${title} — Hye-Young Jo`;

const nav = [
  { label: 'News', href: '/#news' },
  { label: 'Work', href: '/#work' },
  { label: 'More', href: '/more' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=pause_circle,play_circle"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">Hye-Young Jo</a>
        <nav class="site-nav">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} Hye-Young Jo</div>
    </footer>
  </body>
</html>
