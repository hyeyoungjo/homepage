---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  { y: '–2015', t: 'Fine Art', d: 'Painting & media arts' },
  { y: '2016–18', t: 'Film VFX', d: 'Dexter Studios' },
  { y: '2018–19', t: 'XR Generalist', d: 'Immersive content' },
  { y: '2020–now', t: 'HCI Research', d: 'KAIST → CU Boulder' },
];
const colors = ['#c97b3c', '#7a5a86', '#3f8aa6', '#2f5fd0'];
const last = steps.length - 1;
---

<BaseLayout title="Timeline options">
  <div class="container section">
    <h1>Timeline options</h1>
    <p style="color:#6b6b6b">Scroll down — each animates when it enters view. Tell me the number you like (and where to place it: home / work / more / next to the tagline).</p>

    <!-- 1: inline flow (compact, fits next to the tagline) -->
    <section class="opt" data-reveal>
      <h2 class="opt__h">1 — Inline flow (compact)</h2>
      <p class="t1">
        {steps.map((s, i) => (
          <Fragment>
            <span class="t1__item" style={`--i:${i}`}>{s.t}</span>
            {i < last && <span class="t1__arrow" style={`--i:${i}`}>→</span>}
          </Fragment>
        ))}
      </p>
    </section>

    <!-- 2: horizontal nodes with drawing line -->
    <section class="opt" data-reveal>
      <h2 class="opt__h">2 — Horizontal nodes + drawing line</h2>
      <div class="t2">
        {steps.map((s, i) => (
          <div class="t2__step" style={`--i:${i}`}>
            <span class="t2__dot" />
            <div class="t2__y">{s.y}</div>
            <div class="t2__t">{s.t}</div>
            <div class="t2__d">{s.d}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3: vertical timeline, slide in from left -->
    <section class="opt" data-reveal>
      <h2 class="opt__h">3 — Vertical timeline</h2>
      <div class="t3">
        {steps.map((s, i) => (
          <div class="t3__step" style={`--i:${i}`}>
            <span class="t3__dot" />
            <div class="t3__y">{s.y}</div>
            <div class="t3__t">{s.t}</div>
            <div class="t3__d">{s.d}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4: gradient arrow blocks (pop in) -->
    <section class="opt" data-reveal>
      <h2 class="opt__h">4 — Gradient blocks</h2>
      <div class="t4">
        {steps.map((s, i) => (
          <Fragment>
            <div class="t4__block" style={`--i:${i}; background:${colors[i]}`}>
              <div class="t4__y">{s.y}</div>
              <div class="t4__t">{s.t}</div>
            </div>
            {i < last && <span class="t4__arrow">›</span>}
          </Fragment>
        ))}
      </div>
    </section>

    <!-- 5: SVG draw path -->
    <section class="opt" data-reveal>
      <h2 class="opt__h">5 — SVG draw path</h2>
      <svg class="t5" viewBox="0 0 800 110" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Career path">
        <polyline class="t5__line" points="100,50 300,50 500,50 700,50" />
        {steps.map((s, i) => {
          const x = 100 + i * 200;
          return (
            <g class="t5__node" style={`--i:${i}`}>
              <circle cx={x} cy="50" r="9" />
              <text x={x} y="28" text-anchor="middle" class="t5__y">{s.y}</text>
              <text x={x} y="80" text-anchor="middle" class="t5__t">{s.t}</text>
            </g>
          );
        })}
      </svg>
    </section>

    <p style="margin-top:3rem;color:#6b6b6b">→ 마음에 드는 번호 + 위치 알려주세요. 고르면 그걸 실제 위치에 적용하고 이 미리보기는 지울게요.</p>
  </div>
</BaseLayout>

<style>
  .opt { padding: 2.5rem 0; border-bottom: 1px solid var(--color-border); }
  .opt__h { font-size: 1rem; color: var(--color-muted); margin: 0 0 1.25rem; font-family: var(--font-sans); font-weight: 600; }

  /* 1 — inline flow */
  .t1 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-family: var(--font-serif); font-size: 1.15rem; }
  .t1__item, .t1__arrow { opacity: 0; transform: translateY(8px); transition: opacity 0.4s ease, transform 0.4s ease; transition-delay: calc(var(--i) * 0.12s); }
  .t1__item { font-weight: 600; }
  .t1__arrow { color: var(--color-accent); }
  .opt.in .t1__item, .opt.in .t1__arrow { opacity: 1; transform: none; }

  /* 2 — horizontal nodes */
  .t2 { display: grid; grid-template-columns: repeat(4, 1fr); position: relative; }
  .t2::before { content: ''; position: absolute; top: 8px; left: 12.5%; right: 12.5%; height: 2px; background: var(--color-accent); transform: scaleX(0); transform-origin: left; transition: transform 0.9s ease; }
  .opt.in .t2::before { transform: scaleX(1); }
  .t2__step { text-align: center; opacity: 0; transform: translateY(10px); transition: opacity 0.5s ease, transform 0.5s ease; transition-delay: calc(0.2s + var(--i) * 0.18s); }
  .opt.in .t2__step { opacity: 1; transform: none; }
  .t2__dot { display: block; width: 18px; height: 18px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 4px var(--color-bg); margin: 0 auto 0.5rem; }
  .t2__y { font-size: 0.75rem; color: var(--color-muted); }
  .t2__t { font-weight: 600; font-family: var(--font-serif); }
  .t2__d { font-size: 0.8rem; color: var(--color-muted); }

  /* 3 — vertical */
  .t3 { position: relative; padding-left: 2rem; }
  .t3::before { content: ''; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: var(--color-accent); transform: scaleY(0); transform-origin: top; transition: transform 0.9s ease; }
  .opt.in .t3::before { transform: scaleY(1); }
  .t3__step { position: relative; padding: 0.2rem 0 1.1rem; opacity: 0; transform: translateX(-14px); transition: opacity 0.5s ease, transform 0.5s ease; transition-delay: calc(0.15s + var(--i) * 0.18s); }
  .opt.in .t3__step { opacity: 1; transform: none; }
  .t3__dot { position: absolute; left: -2rem; top: 0.35rem; width: 16px; height: 16px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 4px var(--color-bg); }
  .t3__y { font-size: 0.75rem; color: var(--color-muted); }
  .t3__t { font-weight: 600; font-family: var(--font-serif); font-size: 1.05rem; }
  .t3__d { font-size: 0.82rem; color: var(--color-muted); }

  /* 4 — gradient blocks */
  .t4 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .t4__block { flex: 1 1 130px; border-radius: 12px; padding: 0.9rem 1rem; color: #fff; opacity: 0; transform: scale(0.9); transition: opacity 0.45s ease, transform 0.45s ease; transition-delay: calc(var(--i) * 0.15s); }
  .opt.in .t4__block { opacity: 1; transform: none; }
  .t4__y { font-size: 0.75rem; opacity: 0.85; }
  .t4__t { font-weight: 600; font-family: var(--font-serif); }
  .t4__arrow { color: var(--color-muted); font-size: 1.4rem; }

  /* 5 — svg draw */
  .t5 { width: 100%; height: auto; max-width: 760px; display: block; }
  .t5__line { fill: none; stroke: var(--color-accent); stroke-width: 2; stroke-dasharray: 600; stroke-dashoffset: 600; transition: stroke-dashoffset 1.3s ease 0.1s; }
  .opt.in .t5__line { stroke-dashoffset: 0; }
  .t5__node { opacity: 0; transition: opacity 0.4s ease; transition-delay: calc(0.3s + var(--i) * 0.28s); }
  .opt.in .t5__node { opacity: 1; }
  .t5__node circle { fill: var(--color-accent); }
  .t5__y { fill: var(--color-muted); font-size: 13px; }
  .t5__t { fill: var(--color-fg); font-size: 16px; font-weight: 600; }

  @media (max-width: 640px) {
    .t2 { grid-template-columns: 1fr 1fr; gap: 1rem; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.25 }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>
