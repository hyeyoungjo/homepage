---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { CV, VENUES, type CvListItem, type CvPublication } from '../data/cv';

const projects = await getCollection('projects');
const bySlug = new Map(projects.map((p) => [p.id, p]));

/** Inline markup shared by every CV string: **bold**, *italic*, [text](href),
 *  and citations such as [C4], [F1-F6] or [C7, C8, U1], which link to the
 *  cited item (a range links to its first item). */
function inline(src: string): string {
  return src
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, t, h) => `<a href="${h}">${t}</a>`)
    .replace(/\[([A-Z]\d+(?:-[A-Z]\d+)?(?:, [A-Z]\d+(?:-[A-Z]\d+)?)*)\]/g, (_m, refs: string) =>
      '[' +
      refs
        .split(', ')
        .map((r) => `<a class="cv__ref" href="#${r.split('-')[0]}">${r}</a>`)
        .join(', ') +
      ']',
    )
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

/** "[F6] rest" → { label: 'F6', rest }, so the label can anchor the item. */
function splitLabel(text: string): { label?: string; rest: string } {
  const m = text.match(/^\[([A-Z]\d+)\]\s*(.*)$/s);
  return m ? { label: m[1], rest: m[2] } : { rest: text };
}

const assets = import.meta.glob<{ default: ImageMetadata }>('../assets/cv/**/*.{jpg,png}', { eager: true });

/** A highlighted list item's thumbnail: a project's teaser, or a file under
 *  src/assets/cv/. */
async function listThumb(item: CvListItem) {
  if (typeof item === 'string' || !item.highlight) return undefined;
  let src: ImageMetadata | undefined;
  if (item.ref) {
    src = bySlug.get(item.ref)?.data.teaser;
    if (!src) throw new Error(`cv: no teaser for project "${item.ref}"`);
  } else if (item.image) {
    src = assets[`../assets/cv/${item.image}`]?.default;
    if (!src) throw new Error(`cv: no image src/assets/cv/${item.image}`);
  }
  return src && collageImage(src);
}

/** A collage image and its aspect ratio, which sizes its tile. Wide enough
 *  for the largest tile (about 4in) at 250 dpi. */
async function collageImage(src: ImageMetadata) {
  const img = await getImage({ src, width: Math.min(1000, src.width), format: 'jpg', quality: 85 });
  return { src: img.src, aspect: src.width / src.height };
}

/** A range becomes two gutter lines, start (with its dash) over end. */
function dateLines(date: string): string[] {
  const [start, end] = date.split(' - ');
  return end ? [`${start} -`, end] : [start];
}

/** Build a publication line from the projects collection, so the CV and the
 *  site can never disagree about a title, author list, venue or award. */
async function publication(item: CvPublication) {
  const p = bySlug.get(item.ref);
  if (!p) throw new Error(`cv: no project "${item.ref}"`);
  const d = p.data;

  const authors = d.authors
    .map((a) => {
      const name = a.replace(/\*+$/, '').trim();
      return name === 'Hye-Young Jo' ? `**${name}**` : name;
    })
    .join(', ');

  // Authors. Title. Source. Publisher, year.
  // then on its own line: (ACRONYM 'yy, acceptance rate) Award (video) (PDF)
  const v = d.venue ? VENUES[d.venue] : undefined;
  if (d.venue && !v) throw new Error(`cv: no VENUES entry for "${d.venue}"`);
  const short = v?.acronym && `**${v.acronym} ’${String(d.year).slice(2)}${v.suffix ?? ''}**`;
  const detail = [short, d.acceptanceRate && `acceptance rate: ${d.acceptanceRate}`].filter(Boolean).join(', ');
  const citation = [
    `${authors}.`,
    `**${d.title}**.`,
    v ? `${v.source}.` : '',
    `${v?.publisher ? `${v.publisher}, ` : ''}${d.year}.`,
  ]
    .filter(Boolean)
    .join(' ');
  const meta = detail && `(${detail})`;

  const links = [
    d.links.youtube && { label: 'video', href: d.links.youtube },
    d.links.pdf && { label: 'PDF', href: d.links.pdf },
  ].filter(Boolean) as { label: string; href: string }[];

  // 300 dpi at the printed size (--cv-thumb, 1in), so the thumbnail stays sharp.
  const thumb = d.teaser && (await getImage({ src: d.teaser, width: 300, format: 'jpg', quality: 85 }));

  return {
    citation,
    meta,
    links,
    award: item.note ?? d.award,
    also: item.also,
    thumb: thumb && { src: thumb.src, alt: d.teaserAlt ?? '' },
  };
}

const pubs = new Map(
  await Promise.all(
    CV.sections.flatMap((s) =>
      s.kind === 'publications'
        ? s.items.map(async (i) => [i.label, await publication(i)] as const)
        : [],
    ),
  ),
);

/** Collage tiles for a list section's extra works, each a site project. */
async function collageWorks(slugs: string[] = []) {
  return Promise.all(
    slugs.map(async (slug) => {
      if (slug.includes('/')) {
        const src = assets[`../assets/cv/${slug}`]?.default;
        if (!src) throw new Error(`cv: no image src/assets/cv/${slug}`);
        const area = slug.split('/').pop()!.replace(/\.[^.]+$/, '');
        return { area, ...(await collageImage(src)), caption: undefined as string | undefined };
      }
      const d = bySlug.get(slug)?.data;
      if (!d?.teaser) throw new Error(`cv: no teaser for project "${slug}"`);
      return { area: slug, ...(await collageImage(d.teaser)), caption: undefined as string | undefined };
    }),
  );
}

/** The text column (Letter, less the margins and date gutter) and the
 *  collage gap, in points, for the collage's size arithmetic. */
const COLLAGE_WIDTH_PT = 5.75 * 72;
const COLLAGE_GAP_PT = 3;

const works = new Map(
  await Promise.all(
    CV.sections.flatMap((s) =>
      s.kind === 'list' && s.works ? [collageWorks(s.works).then((w) => [s.title, w] as const)] : [],
    ),
  ),
);

const listItems = new Map(
  await Promise.all(
    CV.sections.flatMap((s) =>
      s.kind === 'list'
        ? s.groups.flatMap((g) => g.items).map(async (i) => [i, { ...splitLabel(typeof i === 'string' ? i : i.text), date: typeof i === 'string' ? undefined : i.date, thumb: await listThumb(i)}] as const)
        : [],
    ),
  ),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{CV.name} · CV</title>
    <meta name="description" content={`Curriculum vitae of ${CV.name}`} />
    <meta name="author" content={CV.name} />
  </head>
  <body>
    <main class="cv">
      <header class="cv__header">
        <h1 class="cv__name">{CV.name}</h1>
        <div class="cv__contact">
          <p>{CV.address.map((l) => <span>{l}</span>)}</p>
          <p class="cv__contact-right">{CV.contact.map((l) => <span set:html={inline(l)} />)}</p>
        </div>
      </header>

      {
        CV.sections.map((section) => (
          <section class="cv__section">
            {/* The showreel link sits beside the heading, not inside it, so the
                PDF bookmark (taken from the heading) reads as the title alone. */}
            <div class="cv__heading">
              <h2>{section.title}</h2>
              {'reel' in section && section.reel && <a class="cv__reel" href={section.reel}>(showreel)</a>}
            </div>

            {section.kind === 'prose' &&
              section.body.map((p) => <p class="cv__prose" set:html={inline(p)} />)}

            {section.kind === 'prose' && section.keywords && (
              <p class="cv__prose cv__keywords">Keywords: {section.keywords.join(', ')}</p>
            )}

            {section.kind === 'entries' && section.summary && (
              <p class="cv__prose cv__summary" set:html={inline(section.summary)} />
            )}

            {section.kind === 'entries' &&
              section.entries.map((e) => (
                <div class="cv__entry cv__row">
                  <span class="cv__gutter cv__date">
                    {e.date && dateLines(e.date).map((d) => <span>{d}</span>)}
                  </span>
                  <div>
                    <p
                      set:html={inline(e.href ? `[**${e.title}**](${e.href})` : `**${e.title}**`)}
                    />
                    {e.lines?.map((l) => <p class="cv__line" set:html={inline(l)} />)}
                    {e.rows?.map((r) => (
                      <p class="cv__row">
                        <span class="cv__gutter cv__date">
                          {r.date && dateLines(r.date).map((d) => <span>{d}</span>)}
                        </span>
                        <span set:html={inline(r.text)} />
                      </p>
                    ))}
                  </div>
                </div>
              ))}

            {section.kind === 'publications' && (
              <>
                {section.summary && <p class="cv__prose cv__summary" set:html={inline(section.summary)} />}
                {section.items.map((item) => {
                  const pub = pubs.get(item.label)!;
                  return (
                    <div class="cv__pub" id={item.label}>
                      <span class="cv__gutter">
                        {pub.thumb && <img class="cv__pub-thumb" src={pub.thumb.src} alt={pub.thumb.alt} />}
                      </span>
                      <p>
                        [{item.label}] <Fragment set:html={inline(pub.citation)} />
                        <br />
                        <Fragment set:html={inline(pub.meta)} />
                        {pub.award && <strong class="cv__pub-award">{pub.award}</strong>}
                        {pub.also}
                        <Fragment
                          set:html={pub.links.map((l) => `(<a href="${l.href}">${l.label}</a>)`).join(' ')}
                        />
                      </p>
                    </div>
                  );
                })}
              </>
            )}

            {section.kind === 'list' && (
              <>
                {/* The summary travels with the collage, so neither is left alone
                    at the foot of a page. */}
                <div class="cv__lead">
                {section.summary && <p class="cv__prose cv__summary" set:html={inline(section.summary)} />}
                {/* A magazine-style collage of the highlighted works, above a
                    uniform text list so the images never break its rhythm. */}
                {section.collage && (() => {
                  const tiles = new Map(
                    [
                      ...section.groups.flatMap((g) =>
                        g.items
                          .map((i) => listItems.get(i)!)
                          .filter((it) => it.thumb)
                          .map((it) => ({ area: it.label!, ...it.thumb!, caption: `[${it.label}]` as string | undefined })),
                      ),
                      ...(works.get(section.title) ?? []),
                    ].map((t) => [t.area, t]),
                  );
                  const tile = (area: string) => {
                    const t = tiles.get(area);
                    if (!t) throw new Error(`cv: no collage tile "${area}"`);
                    return t;
                  };
                  // Every size is computed here in points, so each image keeps its
                  // aspect ratio: a row's columns share one height, a column's
                  // stacked images share its width, and only the thin gaps
                  // between stacked images are trimmed.
                  const W = COLLAGE_WIDTH_PT;
                  const G = COLLAGE_GAP_PT;
                  return (
                    <div class="cv__collage">
                      {section.collage.map((row) => {
                        // A column may pin its share of the row with ":", e.g.
                        // "X1:0.62". The row's height then comes from the pinned
                        // column, which keeps its aspect ratio; the other columns
                        // share the rest and crop their images to fit.
                        const cols = row.split(' ').map((col) => {
                          const [names, share] = col.split(':');
                          const stack = names.split('/').map(tile);
                          return { stack, share: share ? Number(share) : undefined, aspect: 1 / stack.reduce((sum, t) => sum + 1 / t.aspect, 0) };
                        });
                        const free = W - (cols.length - 1) * G;
                        const pinned = cols.find((c) => c.share);
                        const h = pinned ? (free * pinned.share!) / pinned.aspect : free / cols.reduce((sum, c) => sum + c.aspect, 0);
                        if (pinned) {
                          const rest = cols.filter((c) => !c.share);
                          const restAspect = rest.reduce((sum, c) => sum + c.aspect, 0);
                          for (const c of rest) c.aspect = ((free * (1 - pinned.share!)) / h) * (c.aspect / restAspect);
                        }
                        return (
                          <div class="cv__collage-row" style={`height: ${h}pt`}>
                            {cols.map(({ stack, aspect }) => {
                              const w = aspect * h;
                              const freeH = h - (stack.length - 1) * G;
                              const inv = stack.reduce((sum, t) => sum + 1 / t.aspect, 0);
                              return (
                                <div class="cv__collage-col" style={`width: ${w}pt`}>
                                  {stack.map((t) => {
                                    const caption = section.captions?.[t.area] ?? t.caption;
                                    return (
                                      <div class="cv__tile" style={`height: ${(freeH * (1 / t.aspect)) / inv}pt`}>
                                        <img src={t.src} alt="" />
                                        {caption && <span>{caption}</span>}
                                      </div>
                                    );
                                  })}
                                </div>
                              );
                            })}
                          </div>
                        );
                      })}
                    </div>
                  );
                })()}
                </div>
                {section.groups.map((g) => (
                  <div class="cv__group">
                    {g.title && (
                      <p class="cv__line">
                        <strong>{g.title}</strong>
                        {g.reel && <a class="cv__reel" href={g.reel}>(showreel)</a>}
                      </p>
                    )}
                    {g.items.map((i) => {
                      const it = listItems.get(i)!;
                      return (
                        <p class="cv__row cv__item" id={it.label}>
                          <span class="cv__gutter cv__date">{it.date}</span>
                          <span set:html={(it.label ? `[${it.label}] ` : '') + inline(it.rest)} />
                        </p>
                      );
                    })}
                  </div>
                ))}
              </>
            )}
          </section>
        ))
      }
    </main>
  </body>
</html>

<style is:global>
  /* Laid out like a LaTeX academic CV: a left gutter carries each entry's
     dates (and each paper's teaser), so the reader can scan the timeline
     down one column, and the content sits in a single column to its right. */
  @page {
    size: letter;
    margin: 0.8in 0.9in 0.8in 0.6in;

    /* One footer on every page, right-aligned. Chrome draws margin boxes as
       plain generated text, so the whole line shares one style. */
    @bottom-right {
      content: 'Hye-Young Jo · curriculum vitae, page ' counter(page);
      font-family: var(--cv-font);
      font-size: 10pt;
      color: var(--cv-muted);
      vertical-align: top;
      padding-top: 12pt;
    }
  }

  :root {
    --cv-font: Palatino, 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    --cv-fg: #000;
    --cv-muted: #999;
    --cv-rule: #bbb;
    --cv-link: #1155cc;
    --cv-award: #980000;
    --cv-gutter: 1.15in;
    --cv-gap: 12pt;
    --cv-thumb: 1in;
    --cv-collage-gap: 3pt;
  }

  html {
    background: #f4f4f5;
  }

  body {
    margin: 0;
    font-family: var(--cv-font);
    font-size: 10pt;
    line-height: 1.2;
    color: var(--cv-fg);
  }

  /* Everything sits in the content column; gutter items reach back into
     the padding with a negative margin. */
  .cv {
    box-sizing: content-box;
    width: 5.75in;
    margin: 2rem auto;
    padding: 0.8in 0.9in 0.8in calc(0.6in + var(--cv-gutter) + var(--cv-gap));
    background: #fff;
    box-shadow: 0 2px 16px rgb(0 0 0 / 0.12);
  }

  .cv a {
    color: var(--cv-link);
  }

  .cv p {
    margin: 0;
  }

  .cv__name {
    margin: 0 0 8pt;
    font-size: 18pt;
    line-height: 1.2;
  }


  .cv__contact {
    display: flex;
    justify-content: space-between;
    gap: 1em;
  }

  .cv__contact span {
    display: block;
  }

  .cv__contact-right {
    text-align: right;
  }

  .cv__heading {
    display: flex;
    align-items: baseline;
    margin: 20pt 0 8pt;
    padding-bottom: 2pt;
    border-bottom: 0.5pt solid var(--cv-rule);
    break-after: avoid;
  }

  .cv__section h2 {
    margin: 0;
    font-size: 14pt;
    line-height: 1.2;
  }

  .cv .cv__prose {
    margin-bottom: 6pt;
    text-align: justify;
  }

  /* A short list; justifying it would stretch the few gaps it has. */
  .cv .cv__keywords {
    text-align: left;
  }

  /* A section summary is read apart from the items it introduces; it is
     left-aligned, since justifying a short paragraph stretches its gaps. */
  .cv .cv__summary {
    margin-bottom: 12pt;
    text-align: left;
  }

  .cv__entry + .cv__entry {
    margin-top: 0.7em;
  }

  /* An entry, row or paper with something in the gutter: the gutter cell
     hangs left of the content column by exactly its own width plus the gap,
     and spans the whole item so a two-line date never pushes text down. */
  .cv .cv__row,
  .cv .cv__pub {
    display: grid;
    grid-template-columns: var(--cv-gutter) 1fr;
    column-gap: var(--cv-gap);
    margin-left: calc(-1 * (var(--cv-gutter) + var(--cv-gap)));
  }

  .cv__gutter {
    text-align: right;
  }

  .cv__date {
    font-style: italic;
  }

  .cv__date span {
    display: block;
  }

  .cv__pub {
    align-items: start;
    margin-bottom: 8pt;
  }

  /* A line of text starts visually at its cap height, a few points below
     the top of its line box, so thumbnails drop by the same amount to line
     up with the first line. */
  .cv__pub-thumb {
    margin-top: 1.5pt;
  }

  .cv__pub-thumb {
    width: var(--cv-thumb);
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* Citations stay in the text colour; they are links, not emphasis. */
  .cv a.cv__ref {
    color: inherit;
    text-decoration: none;
  }


  .cv .cv__item {
    margin-bottom: 4pt;
  }

  .cv a.cv__reel {
    margin-left: 0.4em;
    font-size: 10pt;
    font-weight: normal;
  }

  /* Rows of uncropped images, each row as wide as the text column; the
     caption sits on the image's upper-left corner. */
  .cv__collage {
    display: flex;
    flex-direction: column;
    gap: var(--cv-collage-gap);
    margin: 2pt 0 12pt;
    break-inside: avoid;
  }

  .cv__lead {
    break-inside: avoid;
  }

  .cv__collage-row {
    display: flex;
    gap: var(--cv-collage-gap);
  }

  .cv__collage-col {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--cv-collage-gap);
  }

  .cv__tile {
    position: relative;
    display: block;
    overflow: hidden;
    flex: none;
    color: #fff;
    text-decoration: none;
  }

  /* Positioned so an image's intrinsic size never feeds the layout; the
     tile's size comes from the aspect-ratio arithmetic alone. */
  .cv__tile img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* An opaque label in a bold sans serif reads over any image. */
  .cv__tile span {
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.2;
    white-space: nowrap;
    padding: 1.5pt 5pt;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.02em;
    background: #000;
  }


  .cv__pub-award {
    color: var(--cv-award);
  }

  .cv em {
    color: var(--cv-award);
  }

  .cv__group {
    margin-bottom: 6pt;
  }

  @media print {
    html {
      background: #fff;
    }
    .cv {
      width: auto;
      margin: 0;
      padding: 0 0 0 calc(var(--cv-gutter) + var(--cv-gap));
      box-shadow: none;
    }
    .cv__section {
      break-inside: auto;
    }
    .cv__heading,
    .cv__summary {
      break-after: avoid;
    }
    .cv__entry,
    .cv__pub {
      break-inside: avoid;
    }
  }
</style>
