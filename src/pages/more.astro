---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import kendo from '../assets/about/kendo.jpg';
import filmmaker from '../assets/about/filmmaker.jpg';
import artsyKid from '../assets/about/artsy-kid.jpg';
import wine from '../assets/about/wine.png';
import travel from '../assets/about/travel.png';
import haru from '../assets/about/haru.jpg';
import badPoser from '../assets/about/bad-poser.jpg';
import presenting from '../assets/about/presenting.webp';

const photos = [
  { src: badPoser, caption: 'Bad poser' },
  { src: presenting, caption: 'Looking serious' },
  { src: kendo, caption: 'Kendo amateur' },
  { src: filmmaker, caption: 'Filming in the rain' },
  { src: artsyKid, caption: 'Artsy kids' },
  { src: travel, caption: 'Missing travel' },
  { src: wine, caption: 'Wine lover' },
  { src: haru, caption: 'My cat Haru' },
];
---

<BaseLayout title="More" description="Hye-Young Jo — before research, and beyond">
  <div class="container section prose about">
    <h1>More</h1>
    <p class="about__sub">Where I came from before research — and what I'm into outside it.</p>

    <h2>Before research</h2>
    <p>
      I studied fine art for 20 years and received a B.F.A. in
      <a href="https://art.snu.ac.kr/en/category/painting-en/" target="_blank" rel="noopener">Painting</a>
      and <a href="https://art.snu.ac.kr/en/category/program-in-media-art-en/" target="_blank" rel="noopener">Media
      Arts</a> at <a href="https://en.snu.ac.kr/index.html" target="_blank" rel="noopener">Seoul National
      University</a>. After graduation, I worked at <a href="http://www.dexterstudios.com/" target="_blank" rel="noopener">Dexter
      Studios</a>, a Korean film company, for four years — first as a VFX compositor in film
      post-production, then as an XR generalist creating 3D characters and virtual environments.
    </p>
    <p>
      I then completed my M.S. in <a href="https://id.kaist.ac.kr/" target="_blank" rel="noopener">Industrial
      Design</a> at <a href="https://kaist.ac.kr/en/" target="_blank" rel="noopener">KAIST</a>, advised by
      <a href="https://make.kaist.ac.kr/andrea" target="_blank" rel="noopener">Prof. Andrea Bianchi</a> in the
      <a href="https://make.kaist.ac.kr/" target="_blank" rel="noopener">MAKE Lab</a>, and worked as a
      research assistant at the <a href="https://artifab.yoonji-kim.com/main-page" target="_blank" rel="noopener">Artifab
      Lab</a>, Chung-Ang University (Prof. Yoonji Kim), and as a research intern at the
      <a href="https://global.fujitsu/en-us/local/technology/research/converging-lab" target="_blank" rel="noopener">Fujitsu
      Converging Lab</a> — before starting my Ph.D. at CU Boulder.
    </p>

    <h2>Showreels</h2>
    <p>Reels from my work across film, immersive content, and fine art.</p>
    <h3>Film VFX</h3>
    <YouTubeEmbed url="https://youtu.be/0x7Rzw4ejqM" title="Film VFX showreel" />
    <h3>Immersive Content (XR)</h3>
    <YouTubeEmbed url="https://youtu.be/xaiEH6rCV44" title="Immersive content showreel" />
    <h3>Fine Art</h3>
    <YouTubeEmbed url="https://youtu.be/KPa9K04bg9M" title="Fine art showreel" />

    <h2>Outside research</h2>
    <div class="about__gallery">
      {
        photos.map((p) => (
          <figure>
            <Image src={p.src} alt={p.caption} widths={[200, 400]} sizes="(max-width: 600px) 45vw, 200px" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</BaseLayout>
