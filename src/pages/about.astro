---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';

const researchInterests = [
  'Human-Computer Interaction',
  'Human-AI Interaction',
  'Creativity Support Tools',
  'Generative Agents',
  'AI-driven Content Adaptation',
  'Embodied AI',
  'XR Interaction',
  'Augmented Instruction',
];
---

<BaseLayout title="About" description="About Hye-Young Jo">
  <div class="container section prose">
    <h1>About</h1>
    <p class="about__sub">Hye-Young Jo · 조혜영 — an HCI researcher, a Kendo enthusiast, a filmmaker, and an artist.</p>

    <p>
      I am a Ph.D. student in Computer Science at the University of Colorado Boulder, advised by
      Prof. Ryo Suzuki in the Programmable Reality Lab at the ATLAS Institute.
    </p>
    <p>
      My research explores how generative AI and extended reality can enable embodied learning and
      creative living. I design interactive systems that support dynamic communication with content
      and transform everyday living into creative activity through media that adapt, evolve, and
      respond to users' actions, context, and intentions. I have published at ACM CHI, UIST, and
      HCIK, and received Best Paper (HCIK'22) and Honorable Mention (CHI'21) awards. My work has
      been recognized and supported by the Google Ph.D. Fellowship.
    </p>
    <p>
      I completed my M.S. in Industrial Design at KAIST, where I was advised by Prof. Andrea Bianchi
      in the MAKE Lab. I then worked as a research assistant at the Artifab Lab, Chung-Ang
      University, with Prof. Yoonji Kim, and as a research intern at the Fujitsu Converging Lab.
    </p>
    <p>
      Before joining the research community, I studied fine art for 20 years and received a B.F.A.
      in Painting and Media Arts at Seoul National University. After graduation, I worked at Dexter
      Studios, a Korean film company, for four years — first as a VFX compositor in film
      post-production, then as an XR generalist creating 3D characters and virtual environments.
    </p>

    <h2>Research interests</h2>
    <p>{researchInterests.join(' · ')}</p>

    <h2>Selected awards</h2>
    <ul>
      <li>Google Ph.D. Fellowship in Human–Computer Interaction (2025)</li>
      <li>Ralph J. Slutz Student Excellence Award (2025)</li>
      <li>Best Paper Award, HCI Korea 2022</li>
      <li>Honorable Mention, ACM CHI 2021</li>
    </ul>

    <h2>Elsewhere</h2>
    <SocialLinks />
  </div>
</BaseLayout>
