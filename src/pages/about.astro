---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout title="About" description="About Hye-Young Jo">
  <div class="container section prose">
    <h1>About</h1>
    <p>
      I'm Hye-Young Jo — an HCI researcher, a Kendo enthusiast, a filmmaker, and an artist.
      I'm a Ph.D. student in Computer Science at the University of Colorado Boulder, advised by
      Prof. Ryo Suzuki in the Programmable Reality Lab (ATLAS Institute). Before research, I spent
      two decades in fine art and film.
    </p>
    <p>
      My research explores generative AI and extended reality for embodied learning and creative
      living — interactive systems that adapt to how people move, behave, and create.
    </p>

    <h2>Education</h2>
    <ul>
      <li><strong>Ph.D. in Computer Science</strong>, University of Colorado Boulder — advised by Prof. Ryo Suzuki</li>
      <li><strong>M.S. in Industrial Design</strong>, KAIST — advised by Prof. Andrea Bianchi (MAKE Lab)</li>
      <li><strong>B.F.A. in Painting &amp; Media Arts</strong>, Seoul National University</li>
    </ul>

    <h2>Experience</h2>
    <ul>
      <li>VFX compositor &amp; XR generalist, <strong>Dexter Studios</strong> (4 years) — 3D characters and virtual environments for film</li>
      <li>Research Assistant, Artifab Lab, Chung-Ang University (Prof. Yoonji Kim)</li>
      <li>Research Intern, Fujitsu</li>
    </ul>

    <h2>Selected Awards</h2>
    <ul>
      <li>Google Ph.D. Fellowship in Human–Computer Interaction (2025)</li>
      <li>Ralph J. Slutz Student Excellence Award (2025)</li>
      <li>Best Paper Award, HCI Korea 2022</li>
      <li>Honorable Mention, ACM CHI 2021</li>
    </ul>

    <h2>Elsewhere</h2>
    <SocialLinks />
  </div>
</BaseLayout>
