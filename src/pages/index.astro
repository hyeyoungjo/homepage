---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  const aVal = a.data.date ? +a.data.date : a.data.year * 10000;
  const bVal = b.data.date ? +b.data.date : b.data.year * 10000;
  return bVal - aVal;
});
---

<BaseLayout>
  <Hero />

  <section id="work" class="container section">
    <Gallery projects={projects} />
  </section>
</BaseLayout>
