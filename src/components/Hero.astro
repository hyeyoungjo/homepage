---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profile from '../assets/profile.jpg';
import { SITE } from '../lib/site';
import SocialLinks from './SocialLinks.astro';

const recentNews = (await getCollection('news'))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 4)
  .map((n) => n.data);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<section class="hero container">
  <div class="hero__photo">
    <Image src={profile} alt={SITE.name} widths={[280, 560]} sizes="240px" />
  </div>
  <div class="hero__text">
    <h1 class="hero__greeting">
      {SITE.greeting}
      <button class="hero__audio" type="button" aria-label="Play name pronunciation" data-audio>
        <span class="material-symbols-outlined" data-icon>play_circle</span>
      </button>
      <audio src={SITE.audio} preload="none"></audio>
    </h1>
    <p class="hero__tagline">{SITE.tagline}</p>
    <p class="hero__intro" set:html={SITE.intro} />
    <p class="hero__intro" set:html={SITE.research} />
    <SocialLinks />
  </div>
  <div class="hero__news">
    <div class="hero__news-head">
      <a href="/news">News</a>
    </div>
    <ul class="hero__news-list">
      {
        recentNews.map((n) => (
          <li>
            <time>{fmtDate(n.date)}</time>
            {n.link ? (
              <a href={n.link} target="_blank" rel="noopener">
                {n.text}
              </a>
            ) : (
              <span>{n.text}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Small play/pause toggle for the voice intro.
  document.querySelectorAll('[data-audio]').forEach((btn) => {
    const audio = btn.nextElementSibling;
    const icon = btn.querySelector('[data-icon]');
    if (!(audio instanceof HTMLAudioElement)) return;
    const setIcon = (name) => { if (icon) icon.textContent = name; };
    btn.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });
    audio.addEventListener('play', () => setIcon('pause_circle'));
    audio.addEventListener('pause', () => setIcon('play_circle'));
    audio.addEventListener('ended', () => setIcon('play_circle'));
  });
</script>
