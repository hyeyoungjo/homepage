---
// Left rail = the career timeline; each stage label titles its showreel on the right.
import YouTubeEmbed from './YouTubeEmbed.astro';

const stages = [
  { label: 'Fine Art', url: 'https://youtu.be/KPa9K04bg9M' },
  { label: 'Film', url: 'https://youtu.be/0x7Rzw4ejqM' },
  { label: 'XR', url: 'https://youtu.be/xaiEH6rCV44' },
  { label: 'Research', url: 'https://youtu.be/4TNg1E6FP04' },
];
---

<ol class="journey">
  {
    stages.map((s) => (
      <li class="journey__item">
        <div class="journey__side">
          <span class="journey__dot" aria-hidden="true" />
          <h3 class="journey__title">{s.label}</h3>
        </div>
        <div class="journey__reel">
          <YouTubeEmbed url={s.url} title={`${s.label} reel`} />
        </div>
      </li>
    ))
  }
</ol>

<style>
  .journey { list-style: none; margin: 1.5rem 0 2.5rem; padding: 0; }
  .journey__item { display: grid; grid-template-columns: 130px 1fr; gap: 1.5rem; align-items: stretch; padding-bottom: 1.75rem; }
  .journey__side { position: relative; padding-left: 1.5rem; }
  .journey__side::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 1.4rem;
    bottom: -1.75rem;
    width: 2px;
    background: var(--color-border);
  }
  .journey__item:last-child .journey__side::before { display: none; }
  .journey__dot {
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg);
  }
  .journey__title { margin: 0; font-size: 1.2rem; font-family: var(--font-serif); }
  .journey__reel :global(.yt) { margin: 0; }
  @media (max-width: 640px) {
    .journey__item { grid-template-columns: 1fr; gap: 0.6rem; }
    .journey__side::before { display: none; }
  }
</style>
