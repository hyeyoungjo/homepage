---
// Career timeline: each stage titles its showreel. The reel spans the full text
// width; the dot + connecting line sit in the left margin beside it.
//
// The videos are served from this repo rather than YouTube, so they cannot be
// broken by a platform visibility setting. A stage without a file is skipped.
const stages = [
  { label: 'Fine Art', src: '/reels/fine-art.mp4', poster: '/reels/fine-art.jpg' },
  { label: 'Film', src: '/reels/film.mp4', poster: '/reels/film.jpg' },
  { label: 'XR', src: null, poster: null },
  { label: 'Research', src: '/reels/research.mp4', poster: '/reels/research.jpg' },
].filter((s) => s.src);
---

<ol class="journey">
  {
    stages.map((s) => (
      <li class="journey__item">
        <span class="journey__dot" aria-hidden="true" />
        <h3 class="journey__title">{s.label}</h3>
        <div class="journey__reel">
          <video
            class="journey__video"
            controls
            playsinline
            preload="none"
            poster={s.poster}
            aria-label={`${s.label} showreel`}
          >
            <source src={s.src} type="video/mp4" />
          </video>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .journey { list-style: none; margin: 1.5rem 0 2.5rem; padding: 0; position: relative; }
  .journey__item { position: relative; padding-bottom: 2rem; }
  .journey__item:last-child { padding-bottom: 0; }
  /* dot + line in the left margin, beside the full-width content */
  .journey__dot {
    position: absolute;
    left: -2rem;
    top: 0.45rem;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg);
  }
  .journey__item::before {
    content: '';
    position: absolute;
    left: calc(-2rem + 5.5px);
    top: 1.7rem;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
  .journey__item:last-child::before { display: none; }
  .journey__title { margin: 0 0 0.6rem; font-size: 1.2rem; font-family: var(--font-serif); }
  .journey__video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: #000;
  }
</style>
