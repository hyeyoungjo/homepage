---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { TYPE_LABELS } from '../lib/site';
import LinkRow from './LinkRow.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;
const href = `/${project.id}`;

// Precomputed search haystack for client-side filtering.
const search = [d.title, d.authors.join(' '), d.venue, d.abstract, d.tags.join(' ')]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();

// Meta line: avoid repeating the year when the venue already contains it.
const yearStr = String(d.year);
const meta = d.venue
  ? d.venue.includes(yearStr)
    ? d.venue
    : `${d.venue} · ${yearStr}`
  : yearStr;
---

<article
  class="card"
  data-type={d.type}
  data-year={d.year}
  data-tags={d.tags.join(' ')}
  data-featured={String(d.featured)}
  data-search={search}
>
  <a class="card__media" href={href} aria-label={d.title}>
    {
      d.teaser ? (
        <Image
          src={d.teaser}
          alt={d.teaserAlt ?? d.title}
          widths={[400, 800]}
          sizes="(max-width: 600px) 100vw, 400px"
        />
      ) : (
        <div class="card__placeholder" />
      )
    }
  </a>
  <div class="card__body">
    <span class="card__type">{TYPE_LABELS[d.type] ?? d.type}</span>
    <h3 class="card__title"><a href={href}>{d.title}</a></h3>
    <p class="card__meta">{meta}</p>
    {d.abstract && <p class="card__excerpt">{d.abstract}</p>}
    <div class="card__links"><LinkRow links={d.links} originalLink={d.originalLink} /></div>
  </div>
</article>
