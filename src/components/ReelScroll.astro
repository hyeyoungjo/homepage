---
// Option B — scrollytelling: scroll the stages on the left; a sticky reel on the
// right swaps to the stage currently in view. Click the reel to play it.
const reels = [
  { label: 'Fine Art', id: 'KPa9K04bg9M', note: 'Painting & media arts' },
  { label: 'Film', id: '0x7Rzw4ejqM', note: 'VFX compositor at Dexter Studios' },
  { label: 'XR', id: 'xaiEH6rCV44', note: 'Immersive content at Dexter' },
  { label: 'Research', id: '4TNg1E6FP04', note: 'HCI — KAIST → CU Boulder' },
];
const first = reels[0];
---

<div class="rs" data-rs>
  <div class="rs__stages">
    {
      reels.map((r) => (
        <section class="rs__stage" data-yt={r.id} data-thumb={`https://i.ytimg.com/vi/${r.id}/hqdefault.jpg`}>
          <h3 class="rs__h">{r.label}</h3>
          <p class="rs__note">{r.note}</p>
        </section>
      ))
    }
  </div>
  <div class="rs__col">
    <div class="rs__sticky" data-player>
      <button class="rs__facade" type="button" data-yt={first.id} aria-label={`Play ${first.label} reel`}>
        <img data-thumb src={`https://i.ytimg.com/vi/${first.id}/hqdefault.jpg`} alt="reel" />
        <span class="rs__play" aria-hidden="true">▶</span>
      </button>
    </div>
  </div>
</div>

<style>
  .rs { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; }
  .rs__stage { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; border-left: 2px solid var(--color-border); padding-left: 1.25rem; }
  .rs__stage.is-active { border-left-color: var(--color-accent); }
  .rs__h { font-size: 1.8rem; margin: 0 0 0.4rem; transition: color 0.3s ease; }
  .rs__stage.is-active .rs__h { color: var(--color-accent); }
  .rs__note { color: var(--color-muted); margin: 0; }
  .rs__col { height: 100%; }
  .rs__sticky { position: sticky; top: 90px; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius); overflow: hidden; }
  .rs__sticky iframe { width: 100%; height: 100%; border: 0; display: block; }
  .rs__facade { display: block; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; position: relative; }
  .rs__facade img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rs__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2.2rem; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6); }
  @media (max-width: 760px) {
    .rs { grid-template-columns: 1fr; gap: 1rem; }
    .rs__stage { min-height: auto; padding: 1rem 0 1rem 1.25rem; }
    .rs__col { order: -1; }
    .rs__sticky { position: relative; top: 0; }
  }
</style>

<script>
  document.querySelectorAll('[data-rs]').forEach((rs) => {
    const player = rs.querySelector('[data-player]');
    const stages = rs.querySelectorAll('.rs__stage');
    let current = rs.querySelector('.rs__facade')?.getAttribute('data-yt');
    let playing = false;

    const showFacade = (id, thumb) => {
      current = id;
      if (playing) return; // don't interrupt a playing video on scroll
      player.innerHTML =
        `<button class="rs__facade" type="button" data-yt="${id}"><img src="${thumb}" alt="reel" />` +
        `<span class="rs__play">▶</span></button>`;
      bindFacade();
    };
    const play = (id) => {
      playing = true;
      player.innerHTML =
        `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" title="Reel" ` +
        `allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
    };
    const bindFacade = () => {
      const f = player.querySelector('.rs__facade');
      if (f) f.addEventListener('click', () => play(f.getAttribute('data-yt')));
    };
    bindFacade();

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            stages.forEach((s) => s.classList.toggle('is-active', s === e.target));
            showFacade(e.target.getAttribute('data-yt'), e.target.getAttribute('data-thumb'));
          }
        });
      },
      { threshold: 0.6 }
    );
    stages.forEach((s) => io.observe(s));
  });
</script>
