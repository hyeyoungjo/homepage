---
// Option C — cinematic: full-width bands, each a big reel poster with a title.
// Click a band to play that reel in place.
const reels = [
  { label: 'Fine Art', id: 'KPa9K04bg9M' },
  { label: 'Film', id: '0x7Rzw4ejqM' },
  { label: 'XR', id: 'xaiEH6rCV44' },
  { label: 'Research', id: '4TNg1E6FP04' },
];
---

<div class="rb" data-rb>
  {
    reels.map((r, i) => (
      <button
        class="rb__band"
        type="button"
        data-yt={r.id}
        style={`--i:${i}; background-image:url(https://i.ytimg.com/vi/${r.id}/hqdefault.jpg)`}
        aria-label={`Play ${r.label} reel`}
      >
        <span class="rb__num">{String(i + 1).padStart(2, '0')}</span>
        <span class="rb__title">{r.label}</span>
        <span class="rb__play" aria-hidden="true">▶ Watch reel</span>
      </button>
    ))
  }
</div>

<style>
  .rb { display: flex; flex-direction: column; gap: 4px; border-radius: var(--radius); overflow: hidden; }
  .rb__band {
    position: relative; width: 100%; min-height: 150px;
    border: 0; cursor: pointer; color: #fff; text-align: left;
    padding: 1.5rem 1.75rem;
    background-size: cover; background-position: center;
    display: flex; flex-direction: column; justify-content: center;
    transition: min-height 0.4s ease;
  }
  .rb__band::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.35) 60%, rgba(0, 0, 0, 0.15) 100%);
    transition: background 0.3s ease;
  }
  .rb__band:hover { min-height: 200px; }
  .rb__band:hover::before { background: linear-gradient(90deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.25) 70%, rgba(0, 0, 0, 0.1) 100%); }
  .rb__num, .rb__title, .rb__play { position: relative; z-index: 1; }
  .rb__num { font-size: 0.8rem; letter-spacing: 0.1em; opacity: 0.85; }
  .rb__title { font-family: var(--font-serif); font-size: 1.9rem; font-weight: 600; line-height: 1.1; margin: 0.15rem 0; }
  .rb__play { font-size: 0.85rem; opacity: 0; transform: translateY(4px); transition: opacity 0.25s ease, transform 0.25s ease; }
  .rb__band:hover .rb__play { opacity: 0.95; transform: none; }
  .rb__player { aspect-ratio: 16 / 9; background: #000; }
  .rb__player iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>

<script>
  document.querySelectorAll('[data-rb] .rb__band').forEach((band) => {
    band.addEventListener('click', () => {
      const id = band.getAttribute('data-yt');
      const player = document.createElement('div');
      player.className = 'rb__player';
      player.innerHTML =
        `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" title="Reel" ` +
        `allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
      band.replaceWith(player);
    });
  });
</script>
