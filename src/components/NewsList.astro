---
import type { ImageMetadata } from 'astro';
import { fmtNewsDate } from '../lib/site';
import NewsPhotos from './NewsPhotos.astro';

interface NewsItem {
  date: Date;
  text: string;
  link?: string;
  image?: ImageMetadata;
  images?: ImageMetadata[];
  imageAlt?: string;
}

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;
const photos = (n: NewsItem) => n.images ?? (n.image ? [n.image] : []);
---

<ul class="news">
  {
    items.map((n) => (
      <li class="news__item">
        <time class="news__date">{fmtNewsDate(n.date)}</time>
        <div class="news__body">
          <span class="news__text">
            {n.link ? (
              <a href={n.link} target="_blank" rel="noopener">
                {n.text}
              </a>
            ) : (
              n.text
            )}
          </span>
          <NewsPhotos images={photos(n)} alt={n.imageAlt} />
        </div>
      </li>
    ))
  }
</ul>
