---
import type { ImageMetadata } from 'astro';
import { fmtNewsDate } from '../lib/site';
import NewsPhotos from './NewsPhotos.astro';
import NewsText from './NewsText.astro';

interface NewsItem {
  date: Date;
  text: string;
  link?: string;
  image?: ImageMetadata;
  images?: ImageMetadata[];
  imageAlt?: string;
  marks?: string[];
}

interface Props {
  items: NewsItem[];
  /** Home column: same items, no photo strip. */
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
const photos = (n: NewsItem) => n.images ?? (n.image ? [n.image] : []);
---

<ul class:list={['news', compact && 'news--compact']}>
  {
    items.map((n) => (
      <li class="news__item">
        <time class="news__date">{fmtNewsDate(n.date)}</time>
        <div class="news__body">
          <span class="news__text">
            {n.link ? (
              <a href={n.link} target="_blank" rel="noopener">
                <NewsText text={n.text} marks={n.marks} />
              </a>
            ) : (
              <NewsText text={n.text} marks={n.marks} />
            )}
          </span>
          {!compact && <NewsPhotos images={photos(n)} alt={n.imageAlt} />}
        </div>
      </li>
    ))
  }
</ul>
