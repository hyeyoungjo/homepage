---
// Career flow: fine art -> film VFX -> XR -> HCI research.
// Years are approximate — easy to tweak here.
const steps = [
  { period: '–2015', label: 'Fine Art', desc: 'Painting & media arts' },
  { period: '2016–18', label: 'Film VFX', desc: 'Compositor at Dexter Studios' },
  { period: '2018–19', label: 'XR Generalist', desc: 'Immersive content at Dexter' },
  { period: '2020–now', label: 'HCI Research', desc: 'KAIST → CU Boulder' },
];
---

<section class="container tl-section" aria-label="Career timeline">
  <ol class="tl" data-timeline>
    {
      steps.map((s, i) => (
        <li class="tl__step" style={`--i:${i}`}>
          <span class="tl__dot" />
          <span class="tl__period">{s.period}</span>
          <h3 class="tl__label">{s.label}</h3>
          <p class="tl__desc">{s.desc}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .tl-section {
    padding: 1rem 1.25rem 2.5rem;
  }
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    position: relative;
  }
  /* connecting line, drawn left-to-right when in view */
  .tl::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: var(--color-border);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s ease;
  }
  .tl.is-visible::before {
    transform: scaleX(1);
  }
  .tl__step {
    text-align: center;
    position: relative;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
    transition-delay: calc(var(--i) * 0.15s);
  }
  .tl.is-visible .tl__step {
    opacity: 1;
    transform: none;
  }
  .tl__dot {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg);
    margin: 0 auto 0.6rem;
    position: relative;
    z-index: 1;
  }
  .tl__period {
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .tl__label {
    font-size: 1.05rem;
    margin: 0.2rem 0 0.15rem;
  }
  .tl__desc {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
  }
  @media (max-width: 640px) {
    .tl {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .tl::before {
      top: 7px;
      bottom: 7px;
      left: 7px;
      right: auto;
      width: 2px;
      height: auto;
      transform: scaleY(0);
      transform-origin: top;
    }
    .tl.is-visible::before {
      transform: scaleY(1);
    }
    .tl__step {
      display: grid;
      grid-template-columns: 16px 1fr;
      column-gap: 0.85rem;
      text-align: left;
      align-items: center;
    }
    .tl__dot {
      margin: 0;
      grid-row: 1 / span 3;
      align-self: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl::before,
    .tl__step {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.3 }
  );
  document.querySelectorAll('[data-timeline]').forEach((t) => observer.observe(t));
</script>
