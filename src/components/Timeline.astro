---
// Vertical career flow as an SVG "draw" path. Years are approximate — tweak here.
const steps = [
  { y: '–2015', t: 'Fine Art' },
  { y: '2016–18', t: 'Film VFX' },
  { y: '2018–19', t: 'XR' },
  { y: '2020–now', t: 'HCI Research' },
];
---

<div class="tl5" data-timeline>
  <svg
    class="tl5__svg"
    viewBox="0 0 240 360"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Career path: fine art to film VFX to XR to HCI research"
  >
    <polyline class="tl5__line" points="12,30 12,330" />
    {
      steps.map((s, i) => {
        const y = 30 + i * 100;
        return (
          <g class="tl5__node" style={`--i:${i}`}>
            <circle cx="12" cy={y} r="8" />
            <text x="32" y={y} dominant-baseline="central" class="tl5__t">{s.t}</text>
            <text x="32" y={y + 17} class="tl5__y">{s.y}</text>
          </g>
        );
      })
    }
  </svg>
</div>

<style>
  .tl5 { width: 100%; }
  .tl5__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .tl5__line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    transition: stroke-dashoffset 1.2s ease 0.1s;
  }
  .tl5.in .tl5__line { stroke-dashoffset: 0; }
  .tl5__node {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    transition-delay: calc(0.25s + var(--i) * 0.28s);
  }
  .tl5.in .tl5__node { opacity: 1; transform: none; }
  .tl5__node circle { fill: var(--color-accent); }
  .tl5__t { fill: var(--color-fg); font-size: 15px; font-weight: 600; }
  .tl5__y { fill: var(--color-muted); font-size: 12px; }
  @media (prefers-reduced-motion: reduce) {
    .tl5__line { stroke-dashoffset: 0; }
    .tl5__node { opacity: 1; transform: none; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.2 }
  );
  document.querySelectorAll('[data-timeline]').forEach((el) => io.observe(el));
</script>
