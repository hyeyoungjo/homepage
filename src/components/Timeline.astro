---
// Career flow as an SVG "draw" path (design 5). Years are approximate — tweak here.
const steps = [
  { y: '–2015', t: 'Fine Art' },
  { y: '2016–18', t: 'Film VFX' },
  { y: '2018–19', t: 'XR' },
  { y: '2020–now', t: 'HCI Research' },
];
---

<div class="tl5" data-timeline>
  <svg
    class="tl5__svg"
    viewBox="0 0 800 110"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Career path: fine art to film VFX to XR to HCI research"
  >
    <polyline class="tl5__line" points="100,50 300,50 500,50 700,50" />
    {
      steps.map((s, i) => {
        const x = 100 + i * 200;
        return (
          <g class="tl5__node" style={`--i:${i}`}>
            <circle cx={x} cy="50" r="9" />
            <text x={x} y="28" text-anchor="middle" class="tl5__y">{s.y}</text>
            <text x={x} y="82" text-anchor="middle" class="tl5__t">{s.t}</text>
          </g>
        );
      })
    }
  </svg>
</div>

<style>
  .tl5 { margin: 0.25rem 0 1.5rem; max-width: 560px; }
  .tl5__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .tl5__line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    transition: stroke-dashoffset 1.3s ease 0.1s;
  }
  .tl5.in .tl5__line { stroke-dashoffset: 0; }
  .tl5__node {
    opacity: 0;
    transition: opacity 0.4s ease;
    transition-delay: calc(0.3s + var(--i) * 0.28s);
  }
  .tl5.in .tl5__node { opacity: 1; }
  .tl5__node circle { fill: var(--color-accent); }
  .tl5__y { fill: var(--color-muted); font-size: 13px; }
  .tl5__t { fill: var(--color-fg); font-size: 15px; font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    .tl5__line { stroke-dashoffset: 0; }
    .tl5__node { opacity: 1; }
  }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.3 }
  );
  document.querySelectorAll('[data-timeline]').forEach((el) => io.observe(el));
</script>
