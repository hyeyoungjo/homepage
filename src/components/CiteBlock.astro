---
// Rendered *inside* LinkRow's flex row so the button sits on the same line as
// PDF/DOI/Video. Clicking copies the entry straight to the clipboard; the
// source text is kept in a hidden node rather than a data attribute so the
// BibTeX stays readable in the markup.
interface Props {
  bibtex?: string;
}

const { bibtex } = Astro.props;
---

{
  bibtex && (
    <>
      <button class="cite__btn linkrow__btn" type="button">
        BibTeX
      </button>
      <pre class="cite__source" hidden>{bibtex.trim()}</pre>
    </>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('.cite__btn').forEach((btn) => {
    const source = btn.nextElementSibling;
    if (!source) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(source.textContent ?? '');
        btn.textContent = 'Copied';
        btn.classList.add('is-done');
        setTimeout(() => {
          btn.textContent = 'BibTeX';
          btn.classList.remove('is-done');
        }, 1600);
      } catch {
        // Clipboard unavailable (non-secure context): reveal the entry so the
        // reader can select and copy it by hand.
        (source as HTMLElement).hidden = false;
      }
    });
  });
</script>
