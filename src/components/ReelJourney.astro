---
// Career journey as an interactive reel selector: a timeline of stage "tabs"
// (Fine Art -> Film -> XR -> Research) above one large feature player.
const reels = [
  { label: 'Fine Art', id: 'KPa9K04bg9M' },
  { label: 'Film', id: '0x7Rzw4ejqM' },
  { label: 'XR', id: 'xaiEH6rCV44' },
  { label: 'Research', id: '4TNg1E6FP04' },
];
const first = reels[0];
const last = reels.length - 1;
---

<div class="rj" data-rj>
  <div class="rj__tabs">
    {
      reels.map((r, i) => (
        <Fragment>
          <button
            class:list={['rj__tab', { 'is-active': i === 0 }]}
            type="button"
            data-yt={r.id}
            style={`--i:${i}`}
          >
            <img src={`https://i.ytimg.com/vi/${r.id}/hqdefault.jpg`} alt="" loading="lazy" />
            <span class="rj__tablabel">{r.label}</span>
          </button>
          {i < last && <span class="rj__arrow" aria-hidden="true">→</span>}
        </Fragment>
      ))
    }
  </div>

  <div class="rj__stage" data-stage>
    <button class="rj__big" type="button" data-yt={first.id} aria-label={`Play ${first.label} reel`}>
      <img src={`https://i.ytimg.com/vi/${first.id}/hqdefault.jpg`} alt={`${first.label} reel`} />
      <span class="rj__play" aria-hidden="true">▶</span>
    </button>
  </div>
</div>

<style>
  .rj { margin: 1.5rem 0 2.5rem; }
  .rj__tabs { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .rj__tab {
    flex: 1 1 0; min-width: 0;
    border: 0; background: none; padding: 0; cursor: pointer;
    opacity: 0.55; transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .rj__tab:hover { opacity: 1; transform: translateY(-2px); }
  .rj__tab.is-active { opacity: 1; }
  .rj__tab img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    border-radius: 8px; display: block; border: 2px solid transparent;
  }
  .rj__tab.is-active img { border-color: var(--color-accent); }
  .rj__tablabel { display: block; text-align: center; font-size: 0.8rem; font-weight: 600; margin-top: 0.35rem; }
  .rj__tab.is-active .rj__tablabel { color: var(--color-accent); }
  .rj__arrow { flex: none; color: var(--color-muted); margin-bottom: 1.3rem; }

  .rj__stage { position: relative; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius); overflow: hidden; }
  .rj__stage iframe { width: 100%; height: 100%; border: 0; display: block; }
  .rj__big { display: block; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; position: relative; }
  .rj__big img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rj__play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 2.2rem; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.6);
  }
  @media (max-width: 640px) {
    .rj__tabs { flex-wrap: wrap; }
    .rj__tab { flex: 1 1 40%; }
    .rj__arrow { display: none; }
  }
</style>

<script>
  document.querySelectorAll('[data-rj]').forEach((rj) => {
    const stage = rj.querySelector('[data-stage]');
    const tabs = rj.querySelectorAll('.rj__tab');
    const play = (id, activeTab) => {
      stage.innerHTML =
        `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" title="Reel" ` +
        `allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ` +
        `allowfullscreen></iframe>`;
      tabs.forEach((t) => t.classList.toggle('is-active', t === activeTab));
    };
    tabs.forEach((t) => t.addEventListener('click', () => play(t.getAttribute('data-yt'), t)));
    const big = stage.querySelector('.rj__big');
    if (big) big.addEventListener('click', () => play(big.getAttribute('data-yt'), tabs[0]));
  });
</script>
